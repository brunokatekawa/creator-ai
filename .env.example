# Supabase — from your project's API settings (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for Drizzle migrations), Settings > Database
DATABASE_URL=

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=

# Public base URL of this app (used to build webhook callback URLs).
# For local dev, use a tunnel (e.g. `ngrok http 3000`) since fal must reach it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the reconciliation cron endpoint
CRON_SECRET=

# Cost guards
MAX_CREDITS_PER_USER_PER_DAY=500
GENERATION_KILL_SWITCH=false
